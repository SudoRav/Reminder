<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Reminder"
             x:Class="Reminder.CompletedRemindersPage"
             Title="Завершённые">
    <Grid Padding="24, 0, 24, 0" RowDefinitions="Auto,*,Auto" RowSpacing="0">
        <CollectionView x:Name="CompletedRemindersCollectionView"
                        Grid.Row="1"
                        EmptyView="Завершённых напоминаний пока нет">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ReminderItem">
                    <Border Margin="0,0,0,12"
                            Padding="16"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B3A24}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding ., Converter={StaticResource ReminderListPeriodConverter}}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   IsVisible="{Binding ., Converter={StaticResource ReminderListPeriodVisibilityConverter}}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding Text}"
                                   FontSize="18"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding CompletedAt, StringFormat='Завершено: {0:g}'}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#4F6F52, Dark=#A5D6A7}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                WidthRequest="140"
                HeightRequest="40"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="24"
                Text="Напоминания"
                Clicked="OnRemindersClicked" />
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Reminder.ReminderEditorPage"
             Title="Напоминание">
    <Grid x:Name="EditorRootGrid"
          Padding="24"
          RowDefinitions="*,Auto"
          RowSpacing="16">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="12">
                <Label Text="Текст напоминания"
                       FontAttributes="Bold"
                       FontSize="20" />

                <Editor x:Name="ReminderTextEditor"
                        MinimumHeightRequest="180"
                        AutoSize="TextChanges"
                        Placeholder="Введите текст напоминания"
                        SemanticProperties.Hint="Введите текст напоминания" />

                <Label x:Name="DisplayPeriodLabel"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Начало"
                            Clicked="OnStartClicked" />
                    <Button Grid.Column="1"
                            Text="Конец"
                            Clicked="OnEndClicked" />
                </Grid>

                <Border x:Name="DateTimePickerPanel"
                        IsVisible="False"
                        Padding="12"
                        StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <SwipeGestureRecognizer Direction="Right"
                                                Swiped="OnDateTimePickerSwiped" />
                        <SwipeGestureRecognizer Direction="Left"
                                                Swiped="OnDateTimePickerSwiped" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="8">
                        <Label x:Name="DateTimePickerTitle"
                               FontAttributes="Bold" />
                        <Label x:Name="DateTimePickerHint"
                               Grid.Row="1"
                               FontSize="12"
                               Text="Свайп вправо — время, свайп влево — календарь" />
                        <DatePicker x:Name="DisplayDatePicker"
                                    Grid.Row="2"
                                    DateSelected="OnDisplayDateSelected" />
                        <TimePicker x:Name="DisplayTimePicker"
                                    Grid.Row="2"
                                    IsVisible="False"
                                    PropertyChanged="OnDisplayTimeChanged" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="EditorActionButtons"
              Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <Button x:Name="DeleteButton"
                    Text="Завершить"
                    BackgroundColor="#B00020"
                    TextColor="White"
                    Clicked="OnDeleteClicked" />
            <Button Grid.Column="1"
                    Text="Сохранить"
                    Clicked="OnSaveClicked" />
        </Grid>
    </Grid>
</ContentPage>

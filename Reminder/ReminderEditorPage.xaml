<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Reminder"
             x:Class="Reminder.ReminderEditorPage">

    <Grid x:Name="EditorRootGrid"
          Padding="16,-10,16,0"
          RowDefinitions="*,Auto"
          RowSpacing="0">

        <!-- ========================================================== -->
        <!-- ОСНОВНОЕ СОДЕРЖИМОЕ                                        -->
        <!-- ========================================================== -->

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Spacing="12">

                <!-- ================================================== -->
                <!-- ПЕРИОД ОТОБРАЖЕНИЯ                                  -->
                <!-- ================================================== -->

                <Grid x:Name="DisplayPeriodGrid"
                      ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="0">

                    <Label x:Name="DisplayPeriodLabel"
                           Grid.Column="0"
                           FontSize="14"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap"
                           VerticalTextAlignment="Center"
                           MinimumHeightRequest="40" />

                    <CheckBox x:Name="AutoCompleteCheckBox"
                              Grid.Column="1"
                              IsVisible="False"
                              CheckedChanged="OnAutoCompleteChanged" />

                    <Label x:Name="AutoCompleteLabel"
                           Grid.Column="2"
                           FontSize="12"
                           Text="Завершить"
                           IsVisible="False"
                           VerticalTextAlignment="Center" />

                    <CheckBox x:Name="ShowInNotificationCenterCheckBox"
                              Grid.Column="1"
                              IsVisible="False"
                              CheckedChanged="OnShowInNotificationCenterChanged" />

                    <Label x:Name="ShowInNotificationCenterLabel"
                           Grid.Column="2"
                           FontSize="12"
                           Text="Показывать"
                           IsVisible="False"
                           VerticalTextAlignment="Center" />

                </Grid>


                <!-- ================================================== -->
                <!-- ТЕКСТ НАПОМИНАНИЯ                                   -->
                <!-- ================================================== -->

                <Editor x:Name="ReminderTextEditor"
                        MinimumHeightRequest="280"
                        AutoSize="TextChanges"
                        FontSize="18"
                        Placeholder="Введите текст напоминания"
                        SemanticProperties.Hint="Введите текст напоминания"
                        TextChanged="OnReminderChanged" />


                <!-- ================================================== -->
                <!-- НАЧАЛО / КОНЕЦ                                      -->
                <!-- ================================================== -->

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Button x:Name="StartButton"
                            Text="Начало"
                            Clicked="OnStartClicked" />

                    <Button x:Name="EndButton"
                            Grid.Column="1"
                            Text="Конец"
                            Clicked="OnEndClicked" />

                </Grid>


                <!-- ================================================== -->
                <!-- ДОБАВИТЬ ОПОВЕЩЕНИЕ                                 -->
                <!-- ================================================== -->

                <Button x:Name="AddNotificationButton"
                        Text="Добавить"
                        Clicked="OnAddNotificationClicked" />


                <!-- ================================================== -->
                <!-- СПИСОК ОПОВЕЩЕНИЙ                                   -->
                <!-- ================================================== -->

                <CollectionView x:Name="NotificationTimesCollectionView"
                                EmptyView="Оповещения не добавлены">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="0,0,0,8"
                                    Padding="10,0"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#1F2A36}">

                                <Grid ColumnDefinitions="*,Auto,40,40,40">

                                    <Label Text="{Binding DisplayText}"
                                           VerticalOptions="Center">

                                        <Label.GestureRecognizers>

                                            <TapGestureRecognizer
                                                Tapped="OnNotificationTimeTapped"
                                                CommandParameter="{Binding .}" />

                                        </Label.GestureRecognizers>

                                    </Label>


                                    <Button Grid.Column="1"
                                            Text="✖"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="30"
                                            WidthRequest="30"
                                            Clicked="OnDeleteNotificationClicked" />


                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding IsOverlayEnabled, Mode=TwoWay}" />
                                    <!-- OVERLAY -->

                                    <CheckBox Grid.Column="3"
                                              IsChecked="{Binding IsPushEnabled, Mode=TwoWay}" />
                                    <!-- PUSH -->


                                    <CheckBox Grid.Column="4"
                                              IsChecked="{Binding IsAlarmEnabled, Mode=TwoWay}" />
                                    <!-- ALARM -->

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>


        <!-- ========================================================== -->
        <!-- КНОПКА ЗАВЕРШИТЬ                                          -->
        <!-- ========================================================== -->

        <Button x:Name="DeleteButton"
                WidthRequest="140"
                HeightRequest="40"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="20"
                Grid.Row="0"
                Text="Завершить"
                BackgroundColor="#B00020"
                TextColor="White"
                Clicked="OnDeleteClicked" />


        <!-- ========================================================== -->
        <!-- КНОПКА СОХРАНИТЬ                                           -->
        <!-- ========================================================== -->

        <Button x:Name="SaveButton"
                WidthRequest="140"
                HeightRequest="40"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Grid.Row="0"
                Text="Сохранить"
                TextColor="Black"
                Clicked="OnSaveClicked" />


        <!-- ========================================================== -->
        <!-- ОКНО ДОБАВЛЕНИЯ ОПОВЕЩЕНИЯ                                 -->
        <!-- ========================================================== -->

        <Grid x:Name="NotificationAddOverlay"
              Grid.RowSpan="2"
              Padding="16"
              BackgroundColor="#99000000"
              IsVisible="False"
              ZIndex="200">

            <Border Padding="24,22"
                    MaximumWidthRequest="560"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#151A20}"
                    Stroke="{AppThemeBinding Light=#E0E3E8, Dark=#29313A}">

                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="18">

                    <!-- ================================================== -->
                    <!-- ЗАГОЛОВОК                                           -->
                    <!-- ================================================== -->

                    <Label Grid.Row="0"
                           Text="Добавить оповещение"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />


                    <!-- ================================================== -->
                    <!-- Привязка                                              -->
                    <!-- ================================================== -->

                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="6">

                        <Label Text="Привязка"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />


                        <Border Stroke="{AppThemeBinding Light=Gray, Dark=Gray}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="4">

                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="4">

                                <Button x:Name="NotificationNowButton"
                                        Grid.Column="0"
                                        Text="Сейчас"
                                        Clicked="OnNotificationNowClicked"
                                        HorizontalOptions="Fill" />

                                <Button x:Name="NotificationStartButton"
                                        Grid.Column="1"
                                        Text="Начало"
                                        Clicked="OnNotificationStartClicked"
                                        HorizontalOptions="Fill" />

                                <Button x:Name="NotificationEndButton"
                                        Grid.Column="2"
                                        Text="Конец"
                                        Clicked="OnNotificationEndClicked"
                                        HorizontalOptions="Fill" />

                            </Grid>

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================================================== -->
                    <!-- ВРЕМЯ                                           -->
                    <!-- ================================================== -->

                    <VerticalStackLayout Grid.Row="2"
                                         Spacing="6">

                        <Label Text="Время"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />


                        <Border Padding="8,0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18"
                                BackgroundColor="{AppThemeBinding Light=#EBEEF3, Dark=#202831}">

                            <Grid HeightRequest="240"
                                  ColumnDefinitions="*,*,*"
                                  ColumnSpacing="4">


                                <!-- ====================================== -->
                                <!-- КОЛЕСО 1: ЧЕРЕЗ / ЗА                   -->
                                <!-- ====================================== -->

                                <Grid Grid.Column="0">

                                    <ScrollView x:Name="NotificationDirectionWheel"
                                                Orientation="Vertical"
                                                VerticalScrollBarVisibility="Never"
                                                Scrolled="OnNotificationDirectionWheelScrolled">

                                        <VerticalStackLayout x:Name="NotificationDirectionWheelLayout"
                                                             Spacing="0" />

                                    </ScrollView>

                                </Grid>


                                <!-- ====================================== -->
                                <!-- КОЛЕСО 2: 1 - 99                      -->
                                <!-- ====================================== -->

                                <Grid Grid.Column="1">

                                    <ScrollView x:Name="NotificationAmountWheel"
                                                Orientation="Vertical"
                                                VerticalScrollBarVisibility="Never"
                                                Scrolled="OnNotificationAmountWheelScrolled">

                                        <VerticalStackLayout x:Name="NotificationAmountWheelLayout"
                                                             Spacing="0" />

                                    </ScrollView>

                                </Grid>


                                <!-- ====================================== -->
                                <!-- КОЛЕСО 3: МИН / ЧАС / ДЕН              -->
                                <!-- ====================================== -->

                                <Grid Grid.Column="2">

                                    <ScrollView x:Name="NotificationUnitWheel"
                                                Orientation="Vertical"
                                                VerticalScrollBarVisibility="Never"
                                                Scrolled="OnNotificationUnitWheelScrolled">

                                        <VerticalStackLayout x:Name="NotificationUnitWheelLayout"
                                                             Spacing="0" />

                                    </ScrollView>

                                </Grid>


                                <!-- ====================================== -->
                                <!-- ЦЕНТРАЛЬНАЯ ОБЛАСТЬ                    -->
                                <!-- ====================================== -->

                                <Grid Grid.ColumnSpan="3"
                                      InputTransparent="True"
                                      ZIndex="10">

                                    <Border HeightRequest="60"
                                            VerticalOptions="Center"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#444C55, Dark=#3A434D}"
                                            BackgroundColor="Transparent"
                                            StrokeShape="RoundRectangle 3" />

                                    <BoxView HeightRequest="1"
                                             VerticalOptions="Center"
                                             Margin="0,-30,0,0"
                                             BackgroundColor="{AppThemeBinding Light=#555E68, Dark=#4A535E}" />

                                    <BoxView HeightRequest="1"
                                             VerticalOptions="Center"
                                             Margin="0,30,0,0"
                                             BackgroundColor="{AppThemeBinding Light=#555E68, Dark=#4A535E}" />

                                </Grid>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================================================== -->
                    <!-- КНОПКИ                                              -->
                    <!-- ================================================== -->

                    <HorizontalStackLayout Grid.Row="3"
                                           HorizontalOptions="End"
                                           Spacing="24">

                        <Button Text="Отмена"
                                BackgroundColor="Transparent"
                                Clicked="OnCancelNotificationClicked"
                                TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                        <Button Text="Добавить"
                                BackgroundColor="Transparent"
                                Clicked="OnSaveNotificationClicked"
                                TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                    </HorizontalStackLayout>

                </Grid>

            </Border>

        </Grid>


        <!-- ========================================================== -->
        <!-- ОКНО ВЫБОРА ДАТЫ / ВРЕМЕНИ                                 -->
        <!-- ========================================================== -->

        <Grid x:Name="DateTimePickerOverlay"
              Grid.RowSpan="2"
              Padding="16"
              BackgroundColor="#99000000"
              IsVisible="False"
              ZIndex="100">

            <Border Padding="28,24"
                    MaximumWidthRequest="560"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111820}"
                    Stroke="{AppThemeBinding Light=#E7E2F2, Dark=#26313D}">

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="18">

                    <!-- ================================================== -->
                    <!-- ТАЙМЕР                                             -->
                    <!-- ================================================== -->

                    <Border Grid.Row="1"
                            x:Name="TimerDisplayBorder"
                            Padding="18,14"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#EEF2F7, Dark=#202831}">

                        <Grid RowDefinitions="Auto,Auto">

                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*"
      ColumnSpacing="0">

                                <Label x:Name="TimerElapsedSignLabel"
           Grid.Column="1"
           Text="-"
           FontSize="17"
           FontAttributes="Bold"
           VerticalTextAlignment="Center"
           HorizontalTextAlignment="Center"
           WidthRequest="20"
           HeightRequest="30"
           TranslationX="-32"
           IsVisible="False"
           ZIndex="10" />

                                <Label x:Name="TimerDaysDisplayLabel"
           Grid.Column="1"
           Text="00"
           FontSize="34"
           FontAttributes="Bold"
           HorizontalTextAlignment="Center"
           TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                                <Label Grid.Column="2"
           Text=":"
           FontSize="28"
           FontAttributes="Bold"
           VerticalTextAlignment="Center"
           TextColor="{AppThemeBinding Light=#9AA1AA, Dark=#707983}" />

                                <Label x:Name="TimerHoursDisplayLabel"
           Grid.Column="3"
           Text="00"
           FontSize="34"
           FontAttributes="Bold"
           HorizontalTextAlignment="Center"
           TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                                <Label Grid.Column="4"
           Text=":"
           FontSize="28"
           FontAttributes="Bold"
           VerticalTextAlignment="Center"
           TextColor="{AppThemeBinding Light=#9AA1AA, Dark=#707983}" />

                                <Label x:Name="TimerMinutesDisplayLabel"
           Grid.Column="5"
           Text="00"
           FontSize="34"
           FontAttributes="Bold"
           HorizontalTextAlignment="Center"
           TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                            </Grid>


                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*,*"
                                  Margin="0,-2,0,0">

                                <Label Grid.Column="0"
                                       Text="ДНИ"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#7A818A, Dark=#AAB2BC}" />

                                <Label Grid.Column="1"
                                       Text="ЧАСЫ"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#7A818A, Dark=#AAB2BC}" />

                                <Label Grid.Column="2"
                                       Text="МИНУТЫ"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#7A818A, Dark=#AAB2BC}" />

                            </Grid>

                        </Grid>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnTimerDisplayTapped" />

                        </Border.GestureRecognizers>

                    </Border>


                    <!-- ================================================== -->
                    <!-- ДАТА / ВРЕМЯ                                       -->
                    <!-- ================================================== -->

                    <Border Grid.Row="2"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#EBEEF3, Dark=#4A5056}">

                        <Grid RowDefinitions="Auto,1,Auto">

                            <!-- Дата -->

                            <Grid Padding="20,16"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="16">

                                <Label Text="📅"
                                       FontSize="24"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">

                                    <Label Text="Дата"
                                           FontAttributes="Bold" />

                                    <Label x:Name="SelectedDateLabel"
                                           Text="~" />

                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="32"
                                       VerticalOptions="Center" />

                                <DatePicker x:Name="OverlayDatePicker"
                                            Grid.ColumnSpan="3"
                                            DateSelected="OnDisplayDateSelected"
                                            Opacity="0.01"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            BackgroundColor="Transparent" />

                                <Grid.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="OnDateRowTapped" />

                                </Grid.GestureRecognizers>

                            </Grid>


                            <BoxView Grid.Row="1"
                                     HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#D3D7DD, Dark=#111820}" />


                            <!-- Время -->

                            <Grid Grid.Row="2"
                                  Padding="20,16"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="16">

                                <Label Text="🕘"
                                       FontSize="24"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">

                                    <Label Text="Время"
                                           FontAttributes="Bold" />

                                    <Label x:Name="SelectedTimeLabel"
                                           Text="~" />

                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="32"
                                       VerticalOptions="Center" />

                                <TimePicker x:Name="OverlayTimePicker"
                                            Grid.ColumnSpan="3"
                                            PropertyChanged="OnDisplayTimeChanged"
                                            Opacity="0.01"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            BackgroundColor="Transparent" />

                                <Grid.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="OnTimeRowTapped" />

                                </Grid.GestureRecognizers>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- ================================================== -->
                    <!-- БЫСТРОЕ ИЗМЕНЕНИЕ ДАТЫ                             -->
                    <!-- ================================================== -->

                    <Grid Grid.Row="3"
                          ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Stroke="{AppThemeBinding Light=Gray, Dark=Gray}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="5">

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="5">

                                <Button Grid.Column="0"
                                        Text="-1 День"
                                        Clicked="rem1day" />

                                <Button Grid.Column="1"
                                        Text="+1 День"
                                        Clicked="add1day" />

                            </Grid>

                        </Border>


                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Stroke="{AppThemeBinding Light=Gray, Dark=Gray}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="5">

                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="5"
                                  RowSpacing="5">

                                <Button Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Утро 9:00"
                                        Clicked="settime900" />

                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Text="Вечер 21:00"
                                        Clicked="settime2100" />

                                <Button Grid.Row="1"
                                        Grid.Column="0"
                                        Text="День 15:00"
                                        Clicked="settime1500" />

                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Text="Ночь 3:00"
                                        Clicked="settime300" />

                            </Grid>

                        </Border>

                    </Grid>


                    <!-- ================================================== -->
                    <!-- КНОПКИ DATE/TIME                                   -->
                    <!-- ================================================== -->

                    <HorizontalStackLayout Grid.Row="4"
                                           HorizontalOptions="End"
                                           Spacing="24">

                        <Button Text="Сброс"
                                BackgroundColor="Transparent"
                                Clicked="OnResetDateTimeClicked"
                                TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                        <Button Text="Назад"
                                BackgroundColor="Transparent"
                                Clicked="OnCancelDateTimeClicked"
                                TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                        <Button Text="ОК"
                                BackgroundColor="Transparent"
                                Clicked="OnSaveDateTimeClicked"
                                TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                    </HorizontalStackLayout>


                    <!-- ================================================== -->
                    <!-- ОКНО ВЫБОРА ДЛИТЕЛЬНОСТИ ТАЙМЕРА                   -->
                    <!-- ================================================== -->

                    <Grid x:Name="TimerDurationOverlay"
                          Grid.RowSpan="5"
                          Padding="16"
                          BackgroundColor="#99000000"
                          IsVisible="False"
                          ZIndex="100">

                        <Border Padding="24,22"
                                MaximumWidthRequest="560"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill"
                                StrokeShape="RoundRectangle 24"
                                BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#151A20}"
                                Stroke="{AppThemeBinding Light=#E0E3E8, Dark=#29313A}">

                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="18">

                                <Label Grid.Row="0"
                                       Text="Установить таймер"
                                       FontAttributes="Bold"
                                       FontSize="22"
                                       HorizontalOptions="Center" />


                                <!-- ================================================== -->
                                <!-- КОЛЁСА ТАЙМЕРА                                  -->
                                <!-- ================================================== -->

                                <Grid Grid.Row="1"
                                      HeightRequest="240"
                                      ColumnDefinitions="*,Auto,*,Auto,*"
                                      ColumnSpacing="4">

                                    <Grid Grid.Column="0">

                                        <ScrollView x:Name="DaysWheel"
                                                    Orientation="Vertical"
                                                    VerticalScrollBarVisibility="Never"
                                                    Scrolled="OnDaysWheelScrolled">

                                            <VerticalStackLayout x:Name="DaysWheelLayout"
                                                                 Spacing="0" />

                                        </ScrollView>

                                    </Grid>


                                    <Label Grid.Column="1"
                                           Text=":"
                                           FontSize="30"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#858B93, Dark=#7A828C}" />


                                    <Grid Grid.Column="2">

                                        <ScrollView x:Name="HoursWheel"
                                                    Orientation="Vertical"
                                                    VerticalScrollBarVisibility="Never"
                                                    Scrolled="OnHoursWheelScrolled">

                                            <VerticalStackLayout x:Name="HoursWheelLayout"
                                                                 Spacing="0" />

                                        </ScrollView>

                                    </Grid>


                                    <Label Grid.Column="3"
                                           Text=":"
                                           FontSize="30"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#858B93, Dark=#7A828C}" />


                                    <Grid Grid.Column="4">

                                        <ScrollView x:Name="MinutesWheel"
                                                    Orientation="Vertical"
                                                    VerticalScrollBarVisibility="Never"
                                                    Scrolled="OnMinutesWheelScrolled">

                                            <VerticalStackLayout x:Name="MinutesWheelLayout"
                                                                 Spacing="0" />

                                        </ScrollView>

                                    </Grid>


                                    <Grid Grid.ColumnSpan="5"
                                          InputTransparent="True">

                                        <Border HeightRequest="60"
                                                VerticalOptions="Center"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#444C55, Dark=#3A434D}"
                                                BackgroundColor="Transparent"
                                                StrokeShape="RoundRectangle 3" />

                                        <BoxView HeightRequest="1"
                                                 VerticalOptions="Center"
                                                 Margin="0,-30,0,0"
                                                 BackgroundColor="{AppThemeBinding Light=#555E68, Dark=#4A535E}" />

                                        <BoxView HeightRequest="1"
                                                 VerticalOptions="Center"
                                                 Margin="0,30,0,0"
                                                 BackgroundColor="{AppThemeBinding Light=#555E68, Dark=#4A535E}" />

                                    </Grid>

                                </Grid>

                                <Button Grid.Row="2"
        Text="Назад"
        BackgroundColor="Transparent"
        HorizontalOptions="Start"
        Clicked="OnCancelTimerClicked"
        TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                                <Button Grid.Row="2"
        Text="ОК"
        BackgroundColor="Transparent"
        HorizontalOptions="End"
        Clicked="OnSaveTimerClicked"
        TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                            </Grid>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>

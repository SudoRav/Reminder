<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Reminder.ReminderEditorPage"
             Title="Напоминание">
    <Grid x:Name="EditorRootGrid"
          Padding="24"
          RowDefinitions="*,Auto"
          RowSpacing="16">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="12">
                <Label Text="Текст напоминания"
                       FontAttributes="Bold"
                       FontSize="20" />

                <Editor x:Name="ReminderTextEditor"
                        MinimumHeightRequest="180"
                        AutoSize="TextChanges"
                        Placeholder="Введите текст напоминания"
                        SemanticProperties.Hint="Введите текст напоминания" />

                <Label x:Name="DisplayPeriodLabel"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button x:Name="StartButton"
                            Text="Начало"
                            Clicked="OnStartClicked" />
                    <Button x:Name="EndButton"
                            Grid.Column="1"
                            Text="Конец"
                            Clicked="OnEndClicked" />
                </Grid>

                <Grid HeightRequest="48"
                      WidthRequest="48"
                      Opacity="0.01"
                      IsEnabled="True"
                      InputTransparent="False">
                    <DatePicker x:Name="DisplayDatePicker"
                                DateSelected="OnDisplayDateSelected"
                                Unfocused="OnDisplayDatePickerUnfocused" />
                    <TimePicker x:Name="DisplayTimePicker"
                                PropertyChanged="OnDisplayTimeChanged"
                                Unfocused="OnDisplayTimePickerUnfocused" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="EditorActionButtons"
              Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <Button x:Name="DeleteButton"
                    Text="Завершить"
                    BackgroundColor="#B00020"
                    TextColor="White"
                    Clicked="OnDeleteClicked" />
            <Button Grid.Column="1"
                    Text="Сохранить"
                    Clicked="OnSaveClicked" />
        </Grid>
    </Grid>
</ContentPage>

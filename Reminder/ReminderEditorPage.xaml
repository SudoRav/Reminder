<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Reminder"
             x:Class="Reminder.ReminderEditorPage">

    <Grid x:Name="EditorRootGrid"
          Padding="16, -10, 16, 0"
          RowDefinitions="*,Auto"
          RowSpacing="0">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Spacing="12">

                <Grid x:Name="DisplayPeriodGrid"
                      ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="0">

                    <Label x:Name="DisplayPeriodLabel"
                           Grid.Column="0"
                           FontSize="14"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap"
                           VerticalTextAlignment="Center"
                           MinimumHeightRequest="40" />

                    <CheckBox x:Name="AutoCompleteCheckBox"
                              Grid.Column="1"
                              IsVisible="False"
                              CheckedChanged="OnAutoCompleteChanged" />

                    <Label x:Name="AutoCompleteLabel"
                           Grid.Column="2"
                           FontSize="12"
                           Text="Завершить"
                           IsVisible="False"
                           VerticalTextAlignment="Center" />

                    <!-- автозавершение -->

                </Grid>


                <Editor x:Name="ReminderTextEditor"
                        MinimumHeightRequest="280"
                        AutoSize="TextChanges"
                        FontSize="18"
                        Placeholder="Введите текст напоминания"
                        SemanticProperties.Hint="Введите текст напоминания"
                        TextChanged="OnReminderChanged" />


                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Button x:Name="StartButton"
                            Text="Начало"
                            Clicked="OnStartClicked" />

                    <Button x:Name="EndButton"
                            Grid.Column="1"
                            Text="Конец"
                            Clicked="OnEndClicked" />

                </Grid>


                <Grid ColumnDefinitions="Auto,*">

                    <Label Grid.Column="0"
                           FontSize="12"
                           Text="Относительно: "
                           VerticalTextAlignment="Center" />

                    <Border Grid.Column="1"
                            Stroke="{AppThemeBinding Light=Gray, Dark=Gray}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="0">

                        <Grid ColumnDefinitions="Auto,*,*,*"
                              ColumnSpacing="0">

                            <RadioButton x:Name="StartRadioButton"
                                         Grid.Column="1"
                                         FontSize="12"
                                         GroupName="NotificationTarget"
                                         Content="Начала"
                                         CheckedChanged="OnNotificationTargetChanged"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill" />

                            <BoxView Grid.Column="1"
                                     HorizontalOptions="End"
                                     WidthRequest="1"
                                     Color="{AppThemeBinding Light=Gray, Dark=Gray}" />

                            <RadioButton x:Name="VarRadioButton"
                                         Grid.Column="2"
                                         FontSize="12"
                                         GroupName="NotificationTarget"
                                         Content="Напом"
                                         CheckedChanged="OnNotificationTargetChanged"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill" />

                            <BoxView Grid.Column="2"
                                     HorizontalOptions="End"
                                     WidthRequest="1"
                                     Color="{AppThemeBinding Light=Gray, Dark=Gray}" />

                            <RadioButton x:Name="EndRadioButton"
                                         Grid.Column="3"
                                         FontSize="12"
                                         GroupName="NotificationTarget"
                                         Content="Конца"
                                         CheckedChanged="OnNotificationTargetChanged"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill" />

                        </Grid>

                    </Border>

                </Grid>


                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="8">

                    <Button Text="За Неделю"
                            Clicked="OnAddWeekNotificationClicked" />

                    <Button Grid.Column="1"
                            Text="За День"
                            Clicked="OnAddDayNotificationClicked" />

                    <Button Grid.Column="2"
                            Text="За Час"
                            Clicked="OnAddHourNotificationClicked" />

                </Grid>


                <CollectionView x:Name="NotificationTimesCollectionView"
                                EmptyView="Оповещения не добавлены">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="0,0,0,8"
                                    Padding="10,0"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#1F2A36}">

                                <Grid ColumnDefinitions="*,Auto,40,40,40">

                                    <Label Text="{Binding DisplayText}"
                                           VerticalOptions="Center">

                                        <Label.GestureRecognizers>

                                            <TapGestureRecognizer
                                                Tapped="OnNotificationTimeTapped"
                                                CommandParameter="{Binding .}" />

                                        </Label.GestureRecognizers>

                                    </Label>

                                    <Button Grid.Column="1"
                                            Text="✖"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="30"
                                            WidthRequest="30"
                                            Clicked="OnDeleteNotificationClicked" />

                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding IsPushEnabled, Mode=TwoWay}" />
                                    <!-- пуш уведомление -->

                                    <CheckBox Grid.Column="3"
                                              IsChecked="{Binding IsOverlayEnabled, Mode=TwoWay}" />
                                    <!-- Overlay уведомление / сообщение на экране -->

                                    <CheckBox Grid.Column="4"
                                              IsChecked="{Binding IsAlarmEnabled, Mode=TwoWay}" />
                                    <!-- будильник -->

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>


        <Button x:Name="DeleteButton"
                WidthRequest="140"
                HeightRequest="40"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="20"
                Grid.Row="0"
                Text="Завершить"
                BackgroundColor="#B00020"
                TextColor="White"
                Clicked="OnDeleteClicked" />


        <Button x:Name="SaveButton"
                WidthRequest="140"
                HeightRequest="40"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Grid.Row="0"
                Text="Сохранить"
                TextColor="Black"
                Clicked="OnSaveClicked" />


        <!-- ========================================================== -->
        <!-- ОКНО ВЫБОРА ДАТЫ / ВРЕМЕНИ                                  -->
        <!-- ========================================================== -->

        <Grid x:Name="DateTimePickerOverlay"
              Grid.RowSpan="2"
              Padding="16"
              BackgroundColor="#99000000"
              IsVisible="False">

            <Border Padding="28,24"
                    MaximumWidthRequest="560"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111820}"
                    Stroke="{AppThemeBinding Light=#E7E2F2, Dark=#26313D}">

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="18">

                    <!-- ================================================== -->
                    <!-- ТАЙМЕР                                             -->
                    <!-- ================================================== -->

                    <Border Grid.Row="1"
                            x:Name="TimerDisplayBorder"
                            Padding="18,14"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#EEF2F7, Dark=#202831}">

                        <Grid RowDefinitions="Auto,Auto">

                            <Grid ColumnDefinitions="*,Auto,*,Auto,*"
                                  ColumnSpacing="0">

                                <!-- ДНИ -->

                                <Label x:Name="TimerDaysDisplayLabel"
                                       Grid.Column="0"
                                       Text="00"
                                       FontSize="34"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                                <Label Grid.Column="1"
                                       Text=":"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#9AA1AA, Dark=#707983}" />


                                <!-- ЧАСЫ -->

                                <Label x:Name="TimerHoursDisplayLabel"
                                       Grid.Column="2"
                                       Text="00"
                                       FontSize="34"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                                <Label Grid.Column="3"
                                       Text=":"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#9AA1AA, Dark=#707983}" />


                                <!-- МИНУТЫ -->

                                <Label x:Name="TimerMinutesDisplayLabel"
                                       Grid.Column="4"
                                       Text="00"
                                       FontSize="34"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#20242A, Dark=#FFFFFF}" />

                            </Grid>


                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*,*"
                                  Margin="0,-2,0,0">

                                <Label Grid.Column="0"
                                       Text="ДНИ"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#7A818A, Dark=#AAB2BC}" />

                                <Label Grid.Column="1"
                                       Text="ЧАСЫ"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#7A818A, Dark=#AAB2BC}" />

                                <Label Grid.Column="2"
                                       Text="МИНУТЫ"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#7A818A, Dark=#AAB2BC}" />

                            </Grid>

                        </Grid>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnTimerDisplayTapped" />

                        </Border.GestureRecognizers>

                    </Border>


                    <!-- ================================================== -->
                    <!-- ВЫБОР ДАТЫ И ВРЕМЕНИ                                -->
                    <!-- ================================================== -->

                    <Border Grid.Row="2"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#EBEEF3, Dark=#4A5056}">

                        <Grid RowDefinitions="Auto,1,Auto">

                            <!-- Дата -->

                            <Grid Padding="20,16"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="16">

                                <Label Text="📅"
                                       FontSize="24"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">

                                    <Label Text="Date"
                                           FontAttributes="Bold" />

                                    <Label x:Name="SelectedDateLabel"
                                           Text="~" />

                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="32"
                                       VerticalOptions="Center" />

                                <DatePicker x:Name="OverlayDatePicker"
                                            Grid.ColumnSpan="3"
                                            DateSelected="OnDisplayDateSelected"
                                            Opacity="0.01"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            BackgroundColor="Transparent" />

                                <Grid.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="OnDateRowTapped" />

                                </Grid.GestureRecognizers>

                            </Grid>


                            <BoxView Grid.Row="1"
                                     HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#D3D7DD, Dark=#111820}" />


                            <!-- Время -->

                            <Grid Grid.Row="2"
                                  Padding="20,16"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="16">

                                <Label Text="🕘"
                                       FontSize="24"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">

                                    <Label Text="Time"
                                           FontAttributes="Bold" />

                                    <Label x:Name="SelectedTimeLabel"
                                           Text="~" />

                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="32"
                                       VerticalOptions="Center" />

                                <TimePicker x:Name="OverlayTimePicker"
                                            Grid.ColumnSpan="3"
                                            PropertyChanged="OnDisplayTimeChanged"
                                            Opacity="0.01"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            BackgroundColor="Transparent" />

                                <Grid.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="OnTimeRowTapped" />

                                </Grid.GestureRecognizers>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- ================================================== -->
                    <!-- БЫСТРОЕ ИЗМЕНЕНИЕ ДАТЫ                              -->
                    <!-- ================================================== -->

                    <Grid Grid.Row="3"
                          ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <!-- Две кнопки -->

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Stroke="{AppThemeBinding Light=Gray, Dark=Gray}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="5">

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="5">

                                <Button Grid.Column="0"
                                        Text="-1 День"
                                        Clicked="rem1day" />

                                <Button Grid.Column="1"
                                        Text="+1 День"
                                        Clicked="add1day" />

                            </Grid>

                        </Border>


                        <!-- Четыре кнопки -->

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Stroke="{AppThemeBinding Light=Gray, Dark=Gray}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="5">

                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="5"
                                  RowSpacing="5">

                                <Button Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Утро 9:00"
                                        Clicked="settime900" />

                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Text="Вечер 21:00"
                                        Clicked="settime2100" />

                                <Button Grid.Row="1"
                                        Grid.Column="0"
                                        Text="День 15:00"
                                        Clicked="settime1500" />

                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Text="Ночь 3:00"
                                        Clicked="settime300" />

                            </Grid>

                        </Border>

                    </Grid>


                    <!-- ================================================== -->
                    <!-- КНОПКИ ДАТЫ / ВРЕМЕНИ                               -->
                    <!-- ================================================== -->

                    <HorizontalStackLayout Grid.Row="4"
                                           HorizontalOptions="End"
                                           Spacing="24">

                        <Button Text="Сброс"
                                BackgroundColor="Transparent"
                                TextColor="White" />

                        <Button Text="Отмена"
                                BackgroundColor="Transparent"
                                Clicked="OnCancelDateTimeClicked"
                                TextColor="White" />

                        <Button Text="ОК"
                                BackgroundColor="Transparent"
                                Clicked="OnSaveDateTimeClicked"
                                TextColor="White" />

                    </HorizontalStackLayout>


                    <!-- ================================================== -->
                    <!-- ОКНО ВЫБОРА ДЛИТЕЛЬНОСТИ ТАЙМЕРА                    -->
                    <!-- ================================================== -->

                    <Grid x:Name="TimerDurationOverlay"
                          Grid.RowSpan="5"
                          Padding="16"
                          BackgroundColor="#99000000"
                          IsVisible="False"
                          ZIndex="100">

                        <Border Padding="24,22"
                                MaximumWidthRequest="560"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill"
                                StrokeShape="RoundRectangle 24"
                                BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#151A20}"
                                Stroke="{AppThemeBinding Light=#E0E3E8, Dark=#29313A}">

                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="18">

                                <!-- Заголовок -->

                                <Label Grid.Row="0"
                                       Text="Установить таймер"
                                       FontAttributes="Bold"
                                       FontSize="22"
                                       HorizontalOptions="Center" />


                                <!-- ================================================== -->
                                <!-- КОЛЁСА                                            -->
                                <!-- ================================================== -->

                                <Grid Grid.Row="1"
                                      HeightRequest="240"
                                      ColumnDefinitions="*,Auto,*,Auto,*"
                                      ColumnSpacing="4">

                                    <!-- ================= ДНИ ================= -->

                                    <Grid Grid.Column="0">

                                        <ScrollView x:Name="DaysWheel"
                                                    Orientation="Vertical"
                                                    VerticalScrollBarVisibility="Never"
                                                    Scrolled="OnDaysWheelScrolled">

                                            <VerticalStackLayout x:Name="DaysWheelLayout"
                                                                 Spacing="0" />

                                        </ScrollView>

                                    </Grid>


                                    <!-- Разделитель -->

                                    <Label Grid.Column="1"
                                           Text=":"
                                           FontSize="30"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#858B93, Dark=#7A828C}" />


                                    <!-- ================= ЧАСЫ ================= -->

                                    <Grid Grid.Column="2">

                                        <ScrollView x:Name="HoursWheel"
                                                    Orientation="Vertical"
                                                    VerticalScrollBarVisibility="Never"
                                                    Scrolled="OnHoursWheelScrolled">

                                            <VerticalStackLayout x:Name="HoursWheelLayout"
                                                                 Spacing="0" />

                                        </ScrollView>

                                    </Grid>


                                    <!-- Разделитель -->

                                    <Label Grid.Column="3"
                                           Text=":"
                                           FontSize="30"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#858B93, Dark=#7A828C}" />


                                    <!-- ================= МИНУТЫ ================= -->

                                    <Grid Grid.Column="4">

                                        <ScrollView x:Name="MinutesWheel"
                                                    Orientation="Vertical"
                                                    VerticalScrollBarVisibility="Never"
                                                    Scrolled="OnMinutesWheelScrolled">

                                            <VerticalStackLayout x:Name="MinutesWheelLayout"
                                                                 Spacing="0" />

                                        </ScrollView>

                                    </Grid>


                                    <!-- ================================================== -->
                                    <!-- ЦЕНТРАЛЬНАЯ ОБЛАСТЬ                             -->
                                    <!-- ================================================== -->

                                    <Grid Grid.ColumnSpan="5"
                                          InputTransparent="True">

                                        <Border HeightRequest="60"
                                                VerticalOptions="Center"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#444C55, Dark=#3A434D}"
                                                BackgroundColor="Transparent"
                                                StrokeShape="RoundRectangle 3" />

                                        <!-- Верхняя граница -->

                                        <BoxView HeightRequest="1"
                                                 VerticalOptions="Center"
                                                 Margin="0,-30,0,0"
                                                 BackgroundColor="{AppThemeBinding Light=#555E68, Dark=#4A535E}" />

                                        <!-- Нижняя граница -->

                                        <BoxView HeightRequest="1"
                                                 VerticalOptions="Center"
                                                 Margin="0,30,0,0"
                                                 BackgroundColor="{AppThemeBinding Light=#555E68, Dark=#4A535E}" />

                                    </Grid>

                                </Grid>


                                <!-- ================================================== -->
                                <!-- ЕДИНСТВЕННАЯ КНОПКА                            -->
                                <!-- ================================================== -->

                                <Button Grid.Row="2"
                                        Text="ОК"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="End"
                                        Clicked="OnSaveTimerClicked" />

                            </Grid>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>
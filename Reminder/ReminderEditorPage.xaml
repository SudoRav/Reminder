<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Reminder"
             x:Class="Reminder.ReminderEditorPage"
             Title="Напоминание">
    <Grid x:Name="EditorRootGrid"
          Padding="16"
          RowDefinitions="*,Auto"
          RowSpacing="0">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="12">
                <Editor x:Name="ReminderTextEditor"
                        MinimumHeightRequest="230"
                        AutoSize="TextChanges"
                        Placeholder="Введите текст напоминания"
                        SemanticProperties.Hint="Введите текст напоминания" />

                <Label x:Name="DisplayPeriodLabel"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button x:Name="StartButton"
                            Text="Начало"
                            Clicked="OnStartClicked" />
                    <Button x:Name="EndButton"
                            Grid.Column="1"
                            Text="Конец"
                            Clicked="OnEndClicked" />
                </Grid>

                <Border Stroke="{AppThemeBinding Light=Gray, Dark=Gray}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 8"
        Padding="0">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="0">

                        <RadioButton
            x:Name="StartRadioButton"
            Grid.Column="0"
            GroupName="NotificationTarget"
            Content="Начало"
            IsChecked="True"
            CheckedChanged="OnNotificationTargetChanged"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

                        <BoxView
            Grid.Column="0"
            HorizontalOptions="End"
            WidthRequest="1"
            Color="{AppThemeBinding Light=Gray, Dark=Gray}" />

                        <RadioButton
            x:Name="EndRadioButton"
            Grid.Column="1"
            GroupName="NotificationTarget"
            Content="Конец"
            CheckedChanged="OnNotificationTargetChanged"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

                    </Grid>

                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Text="За Неделю"
                            Clicked="OnAddWeekNotificationClicked" />
                    <Button Grid.Column="1"
                            Text="За День"
                            Clicked="OnAddDayNotificationClicked" />
                    <Button Grid.Column="2"
                            Text="За Час"
                            Clicked="OnAddHourNotificationClicked" />
                </Grid>

                <CollectionView x:Name="NotificationTimesCollectionView"
                EmptyView="Оповещения не добавлены"
                MaximumHeightRequest="180">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
            Padding="30,0"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#1F2A36}">

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label Text="{Binding DisplayText}"
                   VerticalOptions="Center">

                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                        Tapped="OnNotificationTimeTapped"
                        CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>

                                    </Label>

                                    <Button Grid.Column="1"
                    Text="Удалить"
                    CommandParameter="{Binding .}"
                    Clicked="OnDeleteNotificationClicked"/>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="EditorActionButtons"
              Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <Button x:Name="DeleteButton"
                    Text="Завершить"
                    BackgroundColor="#B00020"
                    TextColor="White"
                    Clicked="OnDeleteClicked" />
            <Button Grid.Column="1"
                    Text="Сохранить"
                    Clicked="OnSaveClicked" />
        </Grid>

        <Grid x:Name="DateTimePickerOverlay"
              Grid.RowSpan="2"
              Padding="16"
              BackgroundColor="#99000000"
              IsVisible="False">
            <Border Padding="28,24"
                    MaximumWidthRequest="560"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111820}"
                    Stroke="{AppThemeBinding Light=#E7E2F2, Dark=#26313D}">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="22">
                    <Label x:Name="DateTimeOverlayTitle"
                           Text="Select date &amp; time"
                           FontAttributes="Bold"
                           FontSize="22" />

                    <Border Grid.Row="1"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#EBEEF3, Dark=#4A5056}">
                        <Grid RowDefinitions="Auto,1,Auto">
                            <Grid Padding="20,16"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="16">
                                <Label Text="📅"
                                       FontSize="24"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">
                                    <Label Text="Date"
                                           FontAttributes="Bold" />
                                    <Label x:Name="SelectedDateLabel"
                                           Text="~" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="32"
                                       VerticalOptions="Center" />
                                <DatePicker x:Name="OverlayDatePicker"
                                            Grid.ColumnSpan="3"
                                            DateSelected="OnDisplayDateSelected"
                                            Opacity="0.01"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            BackgroundColor="Transparent" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDateRowTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <BoxView Grid.Row="1"
                                     HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#D3D7DD, Dark=#111820}" />

                            <Grid Grid.Row="2"
                                  Padding="20,16"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="16">
                                <Label Text="🕘"
                                       FontSize="24"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">
                                    <Label Text="Time"
                                           FontAttributes="Bold" />
                                    <Label x:Name="SelectedTimeLabel"
                                           Text="~" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="32"
                                       VerticalOptions="Center" />
                                <TimePicker x:Name="OverlayTimePicker"
                                            Grid.ColumnSpan="3"
                                            PropertyChanged="OnDisplayTimeChanged"
                                            Opacity="0.01"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            BackgroundColor="Transparent" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTimeRowTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Grid.Row="2"
                                           HorizontalOptions="End"
                                           Spacing="24">
                        <Button Text="Отмена"
                                BackgroundColor="Transparent"
                                Clicked="OnCancelDateTimeClicked" TextColor="White"/>
                        <Button Text="Save"
                                BackgroundColor="Transparent"
                                Clicked="OnSaveDateTimeClicked" TextColor="White"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
